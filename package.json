{
  "name": "strategypresentation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/studio",
    "build": "npm run build --workspace=apps/studio",
    "type-check": "npm run type-check --workspace=apps/studio",
    "seed": "npx tsx scripts/seed-dev.ts",
    "decks": "npx tsx scripts/render-decks.ts",
    "test": "npx tsx scripts/test-sp.ts",
    "qa:decks": "node scripts/qa-decks.mjs",
    "qa:landing": "node scripts/qa-landing.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "playwright": "1.60.0",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}

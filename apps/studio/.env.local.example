# ============================================================
#  SP Studio — Environment Variables
#  Copy to: apps/studio/.env.local
#  NEVER commit .env.local to Git
# ============================================================

# ── Anthropic ────────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
# Also retrievable from PasswordN at key: ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ─────────────────────────────────────────────────
# SP shares ONE Supabase project with WCS and Brainztem — IntrepidHQ's
# Project (xeaeiowwodppqhswotsx) — rather than running its own. Each
# product gets its own schema: WCS = public, Brainztem = brainztem,
# SP = sp (see supabase/sp-studio-schema.sql). db.ts pins the client
# to schema "sp", so these are just that project's own credentials.
# Get the service role key from: Supabase dashboard → xeaeiowwodppqhswotsx
# → Project Settings → API → service_role key (NOT anon — RLS blocks anon).
SUPABASE_URL=https://xeaeiowwodppqhswotsx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# WCS's own scan lookup (apps/studio/src/lib/wcs-scans.ts, used by the
# /api/demo/lookup "see it in action" flow) falls back to SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY above when unset — since WCS lives in the same
# project, in most setups you do NOT need to set these separately.
# WCS_SUPABASE_URL=https://xeaeiowwodppqhswotsx.supabase.co
# WCS_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Vercel Deploy API ─────────────────────────────────────────
# Get from: vercel.com → Account Settings → Tokens
# Token needs: Deploy scope on strategypresentation project
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxx    # from Vercel project settings
VERCEL_TEAM_ID=team_xxxxxxxxxxxx      # optional — only if using a team account

# ── Inter-app Security (WCS ↔ SP Studio) ────────────────────
# Generate with: openssl rand -hex 32
# This SAME value must be set in WCS as SP_WEBHOOK_SECRET
# Also store in PasswordN at key: SP_WEBHOOK_SECRET
SP_WEBHOOK_SECRET=your_64_char_hex_secret_here

# ── Studio Local Auth ─────────────────────────────────────────
# Simple passphrase for the studio. Server-side only — never expose
# via NEXT_PUBLIC_*. The browser authenticates through POST /api/login
# (HttpOnly cookie); scripts may send it as the x-studio-passphrase header.
# Also store in PasswordN at key: SP_STUDIO_PASSPHRASE
STUDIO_PASSPHRASE=HansStudio2026

# ── Node env ─────────────────────────────────────────────────
NODE_ENV=development
